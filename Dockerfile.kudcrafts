# kudcrafts fork image: ntfy server + embedded web app, built from source.
#
#   docker build -f Dockerfile.kudcrafts --build-arg VERSION=2.28.0-kc.1 -t ntfy-kc .
#   docker build -f Dockerfile.kudcrafts --build-arg WEB_DIR=web-kc ...   # the Kudcrafts web client
#
# WEB_DIR selects the web client embedded as the site (default: the stock "web").
#  - bun.lock present (web-kc): bun install --frozen-lockfile && bun run build:site, which moves the
#    build to ../server/site itself (index.html -> app.html, config.js removed).
#  - otherwise (web): npm ci && npm run build, then the Makefile's web-build moves.
# See "Embedded site contract" in docs/kudcrafts/operations.md.
ARG WEB_DIR=web

# --- Stage 1: web app -> /site
FROM oven/bun:1-alpine AS bun
FROM node:24-alpine AS web
ARG WEB_DIR
RUN apk add --no-cache libstdc++ libgcc
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /src/${WEB_DIR}
COPY ${WEB_DIR}/package.json ${WEB_DIR}/*lock* ./
RUN if [ -f bun.lock ]; then bun install --frozen-lockfile; else npm ci --no-audit --no-fund; fi
COPY ${WEB_DIR}/ ./
RUN mkdir -p /src/server \
 && if [ -f bun.lock ]; then \
      bun run build:site; \
    else \
      npm run build \
      && mv build/index.html build/app.html \
      && rm -f build/config.js \
      && rm -rf /src/server/site \
      && mv build /src/server/site; \
    fi \
 && test -f /src/server/site/app.html \
 && mv /src/server/site /site

# --- Stage 2: Go binary, static, with the site embedded
FROM golang:1.25.8-alpine AS build
ARG VERSION=dev
ARG COMMIT=unknown
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf server/site && mkdir -p server/docs && touch server/docs/index.html
COPY --from=web /site ./server/site
RUN CGO_ENABLED=1 go build \
      -o /ntfy \
      -tags sqlite_omit_load_extension,osusergo,netgo \
      -ldflags "-linkmode=external -extldflags=-static -s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      . \
 && /ntfy --help >/dev/null

# --- Stage 3: runtime, identical to the upstream Dockerfile
FROM alpine
LABEL org.opencontainers.image.source="https://github.com/KudcraftsHQ/ntfy"
LABEL org.opencontainers.image.title="ntfy (kudcrafts)"
LABEL org.opencontainers.image.description="ntfy with the kudcrafts app/topic catalog"
LABEL org.opencontainers.image.licenses="Apache-2.0, GPL-2.0"
RUN apk add --no-cache tzdata
COPY --from=build /ntfy /usr/bin/ntfy
EXPOSE 80/tcp
ENTRYPOINT ["ntfy"]
